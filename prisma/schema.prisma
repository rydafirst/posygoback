  BOUGHT
  OUT_OF_STOCK
  RECEIVED

  @@map("shopping_line_status")
}

model ShoppingRequest {
  id                     String         @id @db.Uuid
  reference              String         @unique @db.VarChar(24)
  countryCode            String         @map("country_code") @db.Char(2)
  currency               String         @db.Char(3)
  buyerId                String         @map("buyer_id") @db.Uuid
  buyerEmail             String         @map("buyer_email") @db.VarChar(254)
  buyerName              String         @map("buyer_name") @db.VarChar(120)
  recipientEncrypted     String         @map("recipient_encrypted")
  recipientCity          String         @map("recipient_city") @db.VarChar(60)
  destinationCountryCode String         @map("destination_country_code") @db.Char(2)
  notes                  String?        @db.VarChar(1000)
  status                 ShoppingStatus @default(REQUESTED)
  warehouseId            String?        @map("warehouse_id") @db.Uuid
  goodsMinor             BigInt         @default(0) @map("goods_minor")
  commissionMinor        BigInt         @default(0) @map("commission_minor")
  deliveryMinor          BigInt         @default(0) @map("delivery_minor")
  totalMinor             BigInt         @default(0) @map("total_minor")
  parcel                 Json?
  quoteExpiresAt         DateTime?      @map("quote_expires_at") @db.Timestamptz(6)
  quotedBy               String?        @map("quoted_by") @db.Uuid
  quotedAt               DateTime?      @map("quoted_at") @db.Timestamptz(6)
  provider               String?        @db.VarChar(20)
  providerReference      String?        @map("provider_reference") @db.VarChar(255)
  paymentId              String?        @map("payment_id") @db.VarChar(255)
  paidAt                 DateTime?      @map("paid_at") @db.Timestamptz(6)
  refundedMinor          BigInt         @default(0) @map("refunded_minor")
  arrivalPhotoFileIds    Json           @default("[]") @map("arrival_photo_file_ids")
  receivedBy             String?        @map("received_by") @db.Uuid
  carrier                String?        @db.VarChar(60)
  trackingNumber         String?        @map("tracking_number") @db.VarChar(64)
  trackingUrl            String?        @map("tracking_url") @db.VarChar(500)
  labelUrl               String?        @map("label_url") @db.VarChar(500)
  shippedBy              String?        @map("shipped_by") @db.Uuid
  shippedAt              DateTime?      @map("shipped_at") @db.Timestamptz(6)
  deliveredAt            DateTime?      @map("delivered_at") @db.Timestamptz(6)
  cancelReason           String?        @map("cancel_reason") @db.VarChar(300)
  confirmTokenHash       String?        @unique @map("confirm_token_hash") @db.VarChar(64)
  confirmExpiresAt       DateTime?      @map("confirm_expires_at") @db.Timestamptz(6)
  confirmedAt            DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  disputeOpen            Boolean        @default(false) @map("dispute_open")
  labelClaimedAt         DateTime?      @map("label_claimed_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  country   Country          @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: NoAction)
  buyer     BuyerAccount     @relation(fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  quoter    User?            @relation("ShoppingQuoter", fields: [quotedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  receiver  User?            @relation("ShoppingReceiver", fields: [receivedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  shipper   User?            @relation("ShoppingShipper", fields: [shippedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines     ShoppingLine[]
  refunds   ShoppingRefund[]

  @@index([countryCode, status, createdAt], map: "shopping_requests_status_idx")
  @@index([buyerId, createdAt], map: "shopping_requests_buyer_idx")
  @@map("shopping_requests")
}

model ShoppingLine {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId        String             @map("request_id") @db.Uuid
  position         Int
  url              String             @db.VarChar(2000)
  description      String             @db.VarChar(300)
  quantity         Int
  status           ShoppingLineStatus @default(REQUESTED)
  unitPriceMinor   BigInt?            @map("unit_price_minor")
  unitWeightGrams  Int?               @map("unit_weight_grams")
  hsCode           String?            @map("hs_code") @db.VarChar(10)
  staffNote        String?            @map("staff_note") @db.VarChar(300)
  retailerOrderRef String?            @map("retailer_order_ref") @db.VarChar(80)
  receivedQuantity Int?               @map("received_quantity")

  request ShoppingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requestId, position], map: "shopping_lines_position")
  @@map("shopping_lines")
}

model ShoppingRefund {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId        String   @map("request_id") @db.Uuid
  intentKey        String   @unique @map("intent_key") @db.VarChar(120)
  amountMinor      BigInt   @map("amount_minor")
  status           String   @default("PENDING") @db.VarChar(16)
  providerRefundId String?  @unique @map("provider_refund_id") @db.VarChar(255)
  reason           String   @db.VarChar(300)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  request ShoppingRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([requestId], map: "shopping_refunds_request_idx")
  @@map("shopping_refunds")
}

model MigrationLink {
  sourceTable String   @map("source_table") @db.VarChar(40)
  sourceId    String   @map("source_id") @db.VarChar(120)
  targetId    String   @map("target_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([sourceTable, sourceId])
  @@index([targetId], map: "migration_links_target_idx")
  @@map("migration_links")
}

enum SupportCaseKind {
  ERROR
  QUESTION

  @@map("support_case_kind")
}

enum SupportCaseStatus {
  OPEN
  RESOLVED

  @@map("support_case_status")
}

model SupportCase {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference      String            @unique @db.VarChar(20)
  kind           SupportCaseKind
  status         SupportCaseStatus @default(OPEN)
  fingerprint    String?           @db.Char(64)
  page           String            @db.VarChar(300)
  errorCode      String?           @map("error_code") @db.VarChar(60)
  errorStatus    Int?              @map("error_status")
  endpoint       String?           @db.VarChar(200)
  reportCount    Int               @default(1) @map("report_count")
  firstSeenAt    DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt     DateTime?         @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?           @map("resolved_by") @db.Uuid
  resolutionNote String?           @map("resolution_note") @db.VarChar(500)

  resolver User?           @relation("SupportCaseResolver", fields: [resolvedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reports  SupportReport[]

  @@index([status, lastSeenAt], map: "support_cases_status_idx")
  @@index([fingerprint, status], map: "support_cases_fingerprint_idx")
  @@map("support_cases")
}

model SupportReport {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId        String   @map("case_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  contactEmail  String?  @map("contact_email") @db.VarChar(254)
  message       String   @db.VarChar(1000)
  correlationId String?  @map("correlation_id") @db.Uuid
  trail         Json     @default("[]")
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([caseId, createdAt], map: "support_reports_case_idx")
  @@index([userId], map: "support_reports_user_idx")
  @@map("support_reports")
}

enum AssistantOutcome {
  ANSWERED
  UNSURE
  LIMITED
  FAILED

  @@map("assistant_outcome")
}

model AssistantQuestion {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?          @map("user_id") @db.Uuid
  page         String           @db.VarChar(300)
  question     String           @db.VarChar(500)
  outcome      AssistantOutcome
  inputTokens  Int              @default(0) @map("input_tokens")
  outputTokens Int              @default(0) @map("output_tokens")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt], map: "assistant_questions_created_idx")
  @@index([outcome, createdAt], map: "assistant_questions_outcome_idx")
  @@map("assistant_questions")
}

enum EmailStatus {
  SENT
  FAILED

  @@map("email_status")
}

model EmailLogEntry {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toAddress  String      @map("to_address") @db.VarChar(254)
  kind       String      @db.VarChar(60)
  subject    String      @db.VarChar(200)
  status     EmailStatus
  providerId String?     @map("provider_id") @db.VarChar(100)
  error      String?     @db.VarChar(300)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([toAddress, createdAt], map: "email_log_to_idx")
  @@index([createdAt], map: "email_log_created_idx")
  @@map("email_log")
}
