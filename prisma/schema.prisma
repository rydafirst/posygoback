generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CountryStatus {
  PROSPECTIVE
  ONBOARDING
  LIVE
  SUSPENDED
  CLOSED

  @@map("country_status")
}

enum Role {
  VENDOR_OWNER
  VENDOR_MEMBER
  WAREHOUSE_OPERATOR
  FULFILMENT_PARTNER
  PARTNER_STAFF
  COUNTRY_OPS
  FINANCE_ADMIN
  COMPLIANCE
  ADMIN
  SUPER_ADMIN

  @@map("role")
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("user_status")
}

enum VendorStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("vendor_status")
}

enum MfaState {
  VERIFIED
  NOT_REQUIRED
  ENROLMENT_REQUIRED

  @@map("mfa_state")
}

enum CodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MFA_ENROLMENT

  @@map("code_purpose")
}

enum FilePurpose {
  KYC_DOCUMENT
  EVIDENCE_PHOTO
  PRODUCT_IMAGE
  LABEL_DOCUMENT
  GENERAL_ATTACHMENT
  PARTNER_EVIDENCE
  PROOF_OF_ADDRESS
  STOCK_COUNT

  @@map("file_purpose")
}

enum FileStatus {
  PENDING_UPLOAD
  VERIFIED
  REJECTED
  PURGED

  @@map("file_status")
}

enum VerificationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED

  @@map("verification_status")
}

enum LegalDocumentKind {
  VENDOR_AGREEMENT
  TERMS
  PRIVACY
  PARTNER_AGREEMENT
  CUSTODY_TERMS
  NON_DIVERSION
  DATA_PROCESSING
  INSURANCE_OBLIGATION

  @@map("legal_document_kind")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum StorageTier {
  SMALL
  MEDIUM
  LARGE
  X_LARGE
  PALLET

  @@map("storage_tier")
}

enum BarcodeSymbology {
  EAN13
  UPC_A
  GTIN14
  CODE128

  @@map("barcode_symbology")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum ShippingMode {
  LOOSE
  PALLET

  @@map("shipping_mode")
}

enum InboundStatus {
  DRAFT
  SUBMITTED
  ARRIVED
  ON_HOLD
  RECEIVED
  DISCREPANCY
  REJECTED
  RETURN_REQUESTED
  CANCELLED

  @@map("inbound_status")
}

enum LotCondition {
  SELLABLE
  DAMAGED

  @@map("lot_condition")
}

enum MovementType {
  RECEIVE
  PUT_AWAY
  MOVE
  RESERVE
  RELEASE
  SHIP
  ADJUST
  TRANSFER_OUT
  TRANSFER_IN
  RETURN_IN
  WRITE_OFF

  @@map("movement_type")
}

enum CustodyEventType {
  RECEIVED
  PUT_AWAY
  MOVED
  PICKED
  PACKED
  HANDED_OFF
  RELEASED
  TRANSFERRED_OUT
  TRANSFERRED_IN
  WRITTEN_OFF
  RETURNED

  @@map("custody_event_type")
}

enum FeeScheduleStatus {
  PROPOSED
  ACTIVE
  REJECTED
  SUPERSEDED

  @@map("fee_schedule_status")
}

enum WalletStatus {
  ACTIVE
  STORAGE_OVERDUE
  FROZEN
  CLOSED

  @@map("wallet_status")
}

enum LedgerEntryType {
  DEPOSIT
  ONBOARDING
  STORAGE
  FULFILMENT
  SHIPPING
  RETURN
  RECEIVING_HOLD_FEE
  MANUAL_CREDIT
  MANUAL_DEBIT
  REFUND
  REVERSAL
  PAYMENT_REVERSAL
  COMPENSATION
  STOREFRONT_FEE
  REFERRAL_CREDIT
  CARRIED_OVER

  @@map("ledger_entry_type")
}

enum TopUpStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED

  @@map("top_up_status")
}

enum ActivationPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED

  @@map("activation_payment_status")
}

enum AdjustmentDirection {
  CREDIT
  DEBIT

  @@map("adjustment_direction")
}

enum AdjustmentStatus {
  PENDING_APPROVAL
  APPLIED
  REJECTED

  @@map("adjustment_status")
}

model Country {
  code            String        @id @db.Char(2)
  name            String        @db.VarChar(80)
  currency        String        @db.Char(3)
  status          CountryStatus @default(PROSPECTIVE)
  config          Json
  statusReason    String?       @map("status_reason") @db.VarChar(500)
  statusChangedAt DateTime?     @map("status_changed_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lanesFrom        ShippingLane[]       @relation("LaneOrigin")
  lanesTo          ShippingLane[]       @relation("LaneDestination")
  users            User[]
  vendors          Vendor[]
  legalDocuments   LegalDocument[]
  destinations     VendorDestination[]
  verifications    VendorVerification[]
  warehouses       Warehouse[]
  inboundShipments InboundShipment[]
  staffInvitations StaffInvitation[]
  feeSchedules     FeeSchedule[]
  topUps           TopUp[]
  packagingPresets PackagingPreset[]
  ordersFrom       Order[]              @relation("OrderOrigin")
  ordersTo         Order[]              @relation("OrderDestination")
  partners         FulfilmentPartner[]
  activationPayments VendorActivationPayment[]

  custodyClaims    CustodyClaim[]
  custodyAlerts    CustodyAlert[]
  stockTransfers   StockTransfer[]
  storefrontOrders StorefrontOrder[]

  vendorReturns VendorReturn[]

  referralCampaigns ReferralCampaign[]
  referrals         Referral[]

  shoppingRequests ShoppingRequest[]

  @@index([status], map: "countries_status_idx")
  @@map("countries")
}

model ShippingLane {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originCountryCode      String   @map("origin_country_code") @db.Char(2)
  destinationCountryCode String   @map("destination_country_code") @db.Char(2)
  enabled                Boolean  @default(false)
  customsRequired        Boolean  @map("customs_required")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  origin      Country @relation("LaneOrigin", fields: [originCountryCode], references: [code], onDelete: Restrict, onUpdate: NoAction, map: "shipping_lanes_origin_country_code_countries_code_fk")
  destination Country @relation("LaneDestination", fields: [destinationCountryCode], references: [code], onDelete: Restrict, onUpdate: NoAction, map: "shipping_lanes_destination_country_code_countries_code_fk")

  @@unique([originCountryCode, destinationCountryCode], map: "shipping_lanes_route_unique")
  @@index([originCountryCode, enabled], map: "shipping_lanes_origin_enabled_idx")
  @@map("shipping_lanes")
}

model Vendor {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isTestAccount      Boolean      @default(false) @map("is_test_account")
  businessName       String       @map("business_name") @db.VarChar(120)
  signupReferralCode String?      @map("signup_referral_code") @db.VarChar(40)
  countryCode        String       @map("country_code") @db.Char(2)
  status             VendorStatus @default(PENDING_VERIFICATION)
  activationDueAt    DateTime?    @map("activation_due_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  country          Country               @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: NoAction, map: "vendors_country_code_countries_code_fk")
  users            User[]
  files            StoredFile[]
  acceptances      AgreementAcceptance[]
  destinations     VendorDestination[]
  invitations      VendorInvitation[]
  verification     VendorVerification?
  products         Product[]
  barcodes         ProductBarcode[]
  inboundShipments InboundShipment[]
  lots             StockLot[]
  storageBoxes     StorageBox[]
  movements        InventoryMovement[]
  custodyEvents    CustodyEvent[]
  wallets          Wallet[]
  ledgerEntries    LedgerEntry[]
  topUps           TopUp[]
  orders           Order[]
  apiKeys          ApiKey[]
  orderImports     OrderImportBatch[]

  custodyClaims    CustodyClaim[]
  storefront       Storefront?
  payoutAccount    VendorPayoutAccount?
  discountCodes    DiscountCode[]
  storefrontOrders StorefrontOrder[]

  vendorReturns VendorReturn[]

  notifications Notification[]

  referralCode  ReferralCode?
  referredBy    Referral?     @relation("ReferralReferred")
  referralsMade Referral[]    @relation("ReferralReferrer")

  activationPayments VendorActivationPayment[]

  @@index([countryCode, status], map: "vendors_country_status_idx")
  @@map("vendors")
}

model User {
  id                        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String     @unique(map: "users_email_unique") @db.VarChar(254)
  passwordHash              String     @map("password_hash")
  role                      Role
  status                    UserStatus @default(PENDING_EMAIL_VERIFICATION)
  vendorId                  String?    @map("vendor_id") @db.Uuid
  countryCode               String?    @map("country_code") @db.Char(2)
  partnerId                 String?    @map("partner_id") @db.Uuid
  emailVerifiedAt           DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  mfaSecretEncrypted        String?    @map("mfa_secret_encrypted")
  mfaPendingSecretEncrypted String?    @map("mfa_pending_secret_encrypted")
  mfaEnrolledAt             DateTime?  @map("mfa_enrolled_at") @db.Timestamptz(6)
  failedLoginCount          Int        @default(0) @map("failed_login_count")
  lockedUntil               DateTime?  @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt         DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "users_vendor_id_vendors_id_fk")
  country Country? @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: NoAction, map: "users_country_code_countries_code_fk")

  verificationCodes       VerificationCode[]
  sessions                Session[]
  recoveryCodes           RecoveryCode[]
  files                   StoredFile[]
  acceptances             AgreementAcceptance[]
  legalDocuments          LegalDocument[]
  vendorInvitations       VendorInvitation[]
  verificationDecisions   VendorVerification[]
  inboundCreated          InboundShipment[]            @relation("InboundCreatedBy")
  inboundReceived         InboundShipment[]            @relation("InboundReceivedBy")
  inboundMessages         InboundMessage[]
  movements               InventoryMovement[]
  custodyEvents           CustodyEvent[]
  staffInvitations        StaffInvitation[]
  feeSchedulesProposed    FeeSchedule[]                @relation("FeeScheduleProposedBy")
  feeSchedulesDecided     FeeSchedule[]                @relation("FeeScheduleDecidedBy")
  ledgerEntries           LedgerEntry[]
  topUps                  TopUp[]
  adjustmentsRequested    WalletAdjustment[]           @relation("AdjustmentRequestedBy")
  adjustmentsDecided      WalletAdjustment[]           @relation("AdjustmentDecidedBy")
  apiKeysCreated          ApiKey[]                     @relation("ApiKeyCreator")
  ordersCreated           Order[]                      @relation("OrderCreator")
  ordersPacked            Order[]                      @relation("OrderPacker")
  labelsBought            Order[]                      @relation("OrderLabelBuyer")
  orderEvents             OrderEvent[]                 @relation("OrderEventActor")
  cancellationsRequested  OrderCancellationRequest[]   @relation("CancellationRequester")
  cancellationsDecided    OrderCancellationRequest[]   @relation("CancellationDecider")
  orderImports            OrderImportBatch[]           @relation("OrderImportCreator")
  partner                 FulfilmentPartner?           @relation("PartnerUsers", fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  partnersCreated         FulfilmentPartner[]          @relation("PartnerCreator")
  partnerChecksSubmitted  PartnerCheck[]               @relation("CheckSubmitter")
  partnerChecksReviewed   PartnerCheck[]               @relation("CheckReviewer")
  partnerAcceptances      PartnerAgreementAcceptance[]
  insuranceUploaded       PartnerInsurancePolicy[]     @relation("InsuranceUploader")
  insuranceReviewed       PartnerInsurancePolicy[]     @relation("InsuranceReviewer")
  securitiesRecorded      PartnerSecurity[]            @relation("SecurityRecorder")
  securitiesReleased      PartnerSecurity[]            @relation("SecurityReleaser")
  securitiesConfirmed     PartnerSecurity[]            @relation("SecurityConfirmer")
  partnersApproved        FulfilmentPartner[]          @relation("PartnerApprover")
  callsRecorded           PartnerCheck[]               @relation("CallRecorder")
  dispatchPhotos          OrderDispatchPhoto[]
  stockCountsRequested    StockCount[]                 @relation("StockCountRequester")
  stockCountsSubmitted    StockCount[]                 @relation("StockCountSubmitter")
  stockCountsResolved     StockCount[]                 @relation("StockCountResolver")
  mysteryOrdersCreated    MysteryOrder[]               @relation("MysteryCreator")
  mysteryOrdersAssessed   MysteryOrder[]               @relation("MysteryAssessor")
  partnerLedgerEntries    PartnerLedgerEntry[]
  partnerPayoutsRequested PartnerPayout[]              @relation("PayoutRequester")
  partnerPayoutsDecided   PartnerPayout[]              @relation("PayoutDecider")

  claimsAssessed           CustodyClaim[]        @relation("ClaimAssessor")
  claimsDecided            CustodyClaim[]        @relation("ClaimDecider")
  claimsCreated            CustodyClaim[]        @relation("ClaimCreator")
  securityDraws            PartnerSecurityDraw[] @relation("SecurityDrawCreator")
  alertsResolved           CustodyAlert[]        @relation("AlertResolver")
  transfersRequested       StockTransfer[]       @relation("TransferRequester")
  transfersDispatched      StockTransfer[]       @relation("TransferDispatcher")
  transfersReceived        StockTransfer[]       @relation("TransferReceiver")
  discountsCreated         DiscountCode[]        @relation("DiscountCreator")
  storefrontReturnsDecided StorefrontReturn[]    @relation("StorefrontReturnDecider")

  vendorReturnsCreated    VendorReturn[] @relation("VendorReturnCreator")
  vendorReturnsReceived   VendorReturn[] @relation("VendorReturnReceiver")
  vendorReturnsInstructed VendorReturn[] @relation("VendorReturnInstructor")
  vendorReturnsCompleted  VendorReturn[] @relation("VendorReturnCompleter")

  notifications Notification[]

  referralCampaigns ReferralCampaign[] @relation("ReferralCampaignCreator")

  shoppingQuoted   ShoppingRequest[] @relation("ShoppingQuoter")
  shoppingReceived ShoppingRequest[] @relation("ShoppingReceiver")
  shoppingShipped  ShoppingRequest[] @relation("ShoppingShipper")

  supportReports       SupportReport[]
  assistantQuestions   AssistantQuestion[]
  supportCasesResolved SupportCase[]   @relation("SupportCaseResolver")

  productsCreated Product[] @relation("ProductCreator")

  @@index([vendorId], map: "users_vendor_idx")
  @@index([partnerId], map: "users_partner_idx")
  @@index([role, status], map: "users_role_status_idx")
  @@map("users")
}

model VerificationCode {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  purpose    CodePurpose
  codeHash   String      @unique(map: "verification_codes_code_hash_unique") @map("code_hash") @db.Char(64)
  attempts   Int         @default(0)
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?   @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "verification_codes_user_id_users_id_fk")

  @@index([userId, purpose, consumedAt], map: "verification_codes_user_purpose_idx")
  @@map("verification_codes")
}

model Session {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @unique(map: "sessions_refresh_token_hash_unique") @map("refresh_token_hash") @db.Char(64)
  previousTokenHashes String[]  @default(dbgenerated("'{}'::text[]")) @map("previous_token_hashes")
  mfaState            MfaState  @map("mfa_state")
  ip                  String?   @db.VarChar(64)
  userAgent           String?   @map("user_agent") @db.VarChar(512)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason       String?   @map("revoked_reason") @db.VarChar(64)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt          DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sessions_user_id_users_id_fk")

  @@index([userId, revokedAt], map: "sessions_user_revoked_idx")
  @@index([expiresAt], map: "sessions_expires_idx")
  @@map("sessions")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recovery_codes_user_id_users_id_fk")

  @@index([userId, usedAt], map: "recovery_codes_user_used_idx")
  @@map("recovery_codes")
}

model AuditLogEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequence      BigInt   @unique(map: "audit_log_entries_sequence_unique") @default(autoincrement())
  actorId       String?  @map("actor_id") @db.Uuid
  actorRole     Role?    @map("actor_role")
  countryCode   String?  @map("country_code") @db.Char(2)
  vendorId      String?  @map("vendor_id") @db.Uuid
  action        String   @db.VarChar(120)
  resourceType  String   @map("resource_type") @db.VarChar(60)
  resourceId    String?  @map("resource_id") @db.VarChar(120)
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  prevHash      String   @default("") @map("prev_hash") @db.Char(64)
  hash          String   @default("") @db.Char(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt], map: "audit_actor_created_idx")
  @@index([resourceType, resourceId], map: "audit_resource_idx")
  @@index([countryCode, createdAt], map: "audit_country_created_idx")
  @@map("audit_log_entries")
}

model StoredFile {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectKey    String      @unique(map: "stored_files_object_key_unique") @map("object_key") @db.VarChar(300)
  purpose      FilePurpose
  status       FileStatus  @default(PENDING_UPLOAD)
  ownerUserId  String      @map("owner_user_id") @db.Uuid
  vendorId     String?     @map("vendor_id") @db.Uuid
  countryCode  String?     @map("country_code") @db.Char(2)
  declaredMime String      @map("declared_mime") @db.VarChar(100)
  detectedMime String?     @map("detected_mime") @db.VarChar(100)
  maxBytes     Int         @map("max_bytes")
  sizeBytes    Int?        @map("size_bytes")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedAt   DateTime?   @map("verified_at") @db.Timestamptz(6)

  owner             User                     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "stored_files_owner_user_id_users_id_fk")
  vendor            Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "stored_files_vendor_id_vendors_id_fk")
  productImages     Product[]
  insurancePolicies PartnerInsurancePolicy[]
  dispatchPhoto     OrderDispatchPhoto?
  stockCounts       StockCount[]
  inboundPhoto      InboundPhoto?

  @@index([ownerUserId, createdAt], map: "stored_files_owner_created_idx")
  @@index([vendorId, purpose], map: "stored_files_vendor_purpose_idx")
  @@map("stored_files")
}

model VendorVerification {
  vendorId          String             @id @map("vendor_id") @db.Uuid
  countryCode       String             @map("country_code") @db.Char(2)
  status            VerificationStatus @default(NOT_STARTED)
  answersEncrypted  String?            @map("answers_encrypted")
  idNumberEncrypted String?            @map("id_number_encrypted")
  idNumberLast4     String?            @map("id_number_last4") @db.VarChar(4)
  provider          String?            @db.VarChar(32)
  providerReference String?            @map("provider_reference") @db.VarChar(120)
  submittedAt       DateTime?          @map("submitted_at") @db.Timestamptz(6)
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(6)
  decidedBy         String?            @map("decided_by") @db.Uuid
  decisionReason    String?            @map("decision_reason") @db.VarChar(1000)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "vendor_verifications_vendor_id_vendors_id_fk")
  country Country @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: NoAction, map: "vendor_verifications_country_code_countries_code_fk")
  decider User?   @relation(fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "vendor_verifications_decided_by_users_id_fk")

  @@index([countryCode, status, submittedAt], map: "vendor_verifications_country_status_idx")
  @@map("vendor_verifications")
}

model LegalDocument {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode String            @map("country_code") @db.Char(2)
  kind        LegalDocumentKind
  version     String            @db.VarChar(32)
  title       String            @db.VarChar(160)
  body        String
  publishedAt DateTime          @default(now()) @map("published_at") @db.Timestamptz(6)
  createdBy   String?           @map("created_by") @db.Uuid

  country            Country                      @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: NoAction, map: "legal_documents_country_code_countries_code_fk")
  author             User?                        @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "legal_documents_created_by_users_id_fk")
  acceptances        AgreementAcceptance[]
  partnerAcceptances PartnerAgreementAcceptance[]

  @@unique([countryCode, kind, version], map: "legal_documents_version_unique")
  @@index([countryCode, kind, publishedAt], map: "legal_documents_latest_idx")
  @@map("legal_documents")
}

model AgreementAcceptance {
  vendorId        String   @map("vendor_id") @db.Uuid
  legalDocumentId String   @map("legal_document_id") @db.Uuid
  acceptedBy      String   @map("accepted_by") @db.Uuid
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ip              String?  @db.VarChar(64)
  userAgent       String?  @map("user_agent") @db.VarChar(512)

  vendor   Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "agreement_acceptances_vendor_id_vendors_id_fk")
