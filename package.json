{
  "name": "global-fulfilment-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "seed": "ts-node src/database/seed.ts",
    "seed:e2e": "ts-node src/database/seed-e2e.ts",
    "seed:e2e:limits": "ts-node src/database/seed-e2e.ts --limits-only",
    "seed:e2e:buyer-link": "ts-node src/database/seed-e2e.ts --buyer-link",
    "seed:e2e:deliver": "ts-node src/database/seed-e2e.ts --deliver-store-order",
    "seed:e2e:hand-off": "ts-node src/database/seed-e2e.ts --hand-off-order",
    "migrate:us": "node dist/migration/migrate-us.js",
    "seed:e2e:shopping-confirm": "ts-node src/database/seed-e2e.ts --shopping-confirm",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "shared:check": "node scripts/check-shared-copy.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "otplib": "12.0.1",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "20.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "dotenv": "17.2.3",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
