NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
DATABASE_URL="postgresql://gfn:gfn_local_only@localhost:5432/gfn"
DB_STATEMENT_TIMEOUT_MS=15000
DB_POOL_MAX=10
REDIS_URL=redis://:gfn_local_only@localhost:6379/0
TRUST_PROXY_HOPS=0
CLIENT_IP_HEADER=
JWT_ACCESS_SECRET=replace-with-64-random-bytes-base64
JWT_ACCESS_TTL_SECONDS=600
REFRESH_TTL_DAYS=30
MFA_CHALLENGE_SECRET=replace-with-64-random-bytes-base64
FIELD_ENCRYPTION_KEYS=v1:replace-with-32-random-bytes-base64
FIELD_ENCRYPTION_ACTIVE_KEY=v1
BLIND_INDEX_KEY=replace-with-32-random-bytes-base64
COOKIE_DOMAIN=
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=gfn-private
STORAGE_ACCESS_KEY_ID=gfn_local
STORAGE_SECRET_ACCESS_KEY=gfn_local_only_secret
EMAIL_TRANSPORT=log
# One payment account per country. SANDBOX simulates checkout locally and is refused in production.
# Stripe: {"GB":{"processor":"STRIPE","secretKey":"sk_test_…","webhookSecret":"whsec_…","feePercentBps":450,"fixedFeeMinor":30}}
PAYMENT_ACCOUNTS='{"GB":{"processor":"SANDBOX","feePercentBps":450,"fixedFeeMinor":30},"US":{"processor":"SANDBOX","feePercentBps":450,"fixedFeeMinor":30}}'
JOBS_ENABLED=true
# One carrier account per origin country. SANDBOX gives practice rates and labels for development.
# Live: {"GB":{"provider":"SHIPPO","apiKey":"shippo_live_…","webhookToken":"<openssl rand -hex 32>","senderPhone":"+44 …","senderEmail":"dispatch@…"}}
CARRIER_ACCOUNTS='{"GB":{"provider":"SANDBOX"},"US":{"provider":"SANDBOX"}}'
PARTNER_SERVICES='{"provider":"PRACTICE"}'
